rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isVoworaAdmin() {
      return request.auth != null
        && request.auth.token.email == "srimalharsha@gmail.com";
    }

    match /invitations/{invitationId} {
      // Admin can read invitations they created; visitors can read active cards.
      allow get, list: if
        (isVoworaAdmin() && resource.data.createdBy == request.auth.uid)
        || resource.data.isActive == true;

      // Admin can create a card only under their own account.
      allow create: if isVoworaAdmin()
        && request.resource.data.createdBy == request.auth.uid;

      // Admin can edit only their own cards and cannot transfer ownership.
      allow update: if isVoworaAdmin()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == request.auth.uid;

      // Admin can delete only their own cards.
      allow delete: if isVoworaAdmin()
        && resource.data.createdBy == request.auth.uid;
    }
  }
}