rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVoworaAdmin() {
      return request.auth != null
        && request.auth.token.email == "srimalharsha@gmail.com"
;
    }

    match /invitations/{invitationId} {
      // Visitors can only read active invitation cards.
      allow get, list: if (resource.data.isActive == true)
        || (isVoworaAdmin() && resource.data.createdBy == request.auth.uid);

      allow create: if isVoworaAdmin()
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.category is string
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() > 0
        && request.resource.data.description is string
        && request.resource.data.price is number
        && request.resource.data.isActive is bool;

      allow update: if isVoworaAdmin()
        && resource.data.createdBy == request.auth.uid
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.imageUrl is string
        && request.resource.data.isActive is bool;

      allow delete: if isVoworaAdmin()
        && resource.data.createdBy == request.auth.uid;
    }
  }
}